        <mxCell id="35oN9MM1_Ns0ny6m4YtO-3" parent="1" style="rounded=0;whiteSpace=wrap;html=1;direction=south;align=center;" value="que ocurre: se registran datos de empleados en un archivo de nomina&lt;div&gt;responsable: area administrativa&lt;/div&gt;&lt;div&gt;control: validación de identidad, minimización de datos y consentimiento del trabajador&lt;/div&gt;" vertex="1">
          <mxGeometry height="200" width="140" x="66" y="385" as="geometry" />
        </mxCell>
        <mxCell id="35oN9MM1_Ns0ny6m4YtO-4" parent="1" style="rounded=0;whiteSpace=wrap;html=1;" value="que ocurre: el archivo de nomina se almacena en un servidor seguro o en la nube con acceso restringido&lt;div&gt;responsable: area de TI&lt;/div&gt;&lt;div&gt;control: cifrado en reposo, control de accesos, respaldo seguro y registro de accesos&lt;/div&gt;" vertex="1">
          <mxGeometry height="200" width="136" x="260" y="376" as="geometry" />
        </mxCell>
        <mxCell id="35oN9MM1_Ns0ny6m4YtO-5" parent="1" style="rounded=0;whiteSpace=wrap;html=1;" value="que ocurre: se utiliza para calcular costos de mano de obra, presupuestos y analisis de rentabilidad del proyecto de IA&amp;nbsp;&lt;div&gt;responsable: equipo del proyecto&lt;/div&gt;&lt;div&gt;control: acceso solo a personal autorizado&amp;nbsp;&lt;/div&gt;" vertex="1">
          <mxGeometry height="200" width="140" x="450" y="376" as="geometry" />
        </mxCell>
        <mxCell id="35oN9MM1_Ns0ny6m4YtO-6" parent="1" style="rounded=0;whiteSpace=wrap;html=1;" value="que ocurre: se comparte informacion necesaria con el contador, constructora o autoridades fiscales, solo lo indispensable&amp;nbsp;&lt;div&gt;responsable: area administrativa&lt;/div&gt;&lt;div&gt;control: acuerdos de confidencialidad, transferencia cifrada, principio de minimización y registro de destinatarios&amp;nbsp;&lt;/div&gt;" vertex="1">
          <mxGeometry height="200" width="152" x="636" y="376" as="geometry" />
        </mxCell>
        <mxCell id="35oN9MM1_Ns0ny6m4YtO-7" parent="1" style="rounded=0;whiteSpace=wrap;html=1;" value="que ocurre: se conserva durante el tiempo legal y necesario para fines contables y de auditoria&amp;nbsp;&lt;div&gt;responsable: area administrativa&amp;nbsp;&lt;/div&gt;&lt;div&gt;control: politica de retención, revision periodica, almacenamiento seguro y restriccion de accesos&lt;/div&gt;" vertex="1">
          <mxGeometry height="200" width="140" x="840" y="376" as="geometry" />
        </mxCell>
        <mxCell id="35oN9MM1_Ns0ny6m4YtO-8" parent="1" style="rounded=0;whiteSpace=wrap;html=1;" value="que ocurre: se elimina de forma segura cuando ya no se necesita y ha vencido el plazo legal&amp;nbsp;&lt;div&gt;responsable: area de TI&lt;/div&gt;&lt;div&gt;control: borrado seguro; registro de eliminación y verificación de cumplimento&amp;nbsp;&amp;nbsp;&lt;/div&gt;" vertex="1">
          <mxGeometry height="200" width="140" x="1026" y="385" as="geometry" />
        </mxCell>
